# Function to add 2 to every element in the array
def add_two(numbers):

    # Create an empty list to store updated values
    result = []

    # Loop through each element in the array
    for num in numbers:

        # Add 2 to the current element
        updated_value = num + 2

        # Add the updated value to the result list
        result.append(updated_value)

    # Return the updated array
    return result


# Input array
numbers = [12,13,14,15]

# Call the function
output = add_two(numbers)

# Print the updated array
print("Original Array:", numbers)
print("Updated Array:", output)
